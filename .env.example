# ---- Core ----
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/postengine

# ---- Auth ----
JWT_SECRET=replace-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-too
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15

# ---- Storage ----
# provider: local | s3 | cloudinary
STORAGE_PROVIDER=local
STORAGE_PUBLIC_BASE_URL=http://localhost:5000/static
STORAGE_LOCAL_DIR=./uploads
# S3 (when STORAGE_PROVIDER=s3)
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_EXPIRES_SECONDS=300
# Cloudinary (when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Payments (Razorpay) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Mail ----
# driver: smtp | resend | ses | console
MAIL_DRIVER=console
MAIL_FROM="PostEngine <no-reply@postengine.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
RESEND_API_KEY=

# ---- Meta (Facebook + Instagram via Facebook Login) ----
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/v1/social/oauth/meta/callback
META_GRAPH_VERSION=v21.0
META_OAUTH_STATE_SECRET=

# ---- Instagram Business Login (direct Instagram connection, separate from Meta) ----
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/v1/social/auth/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
INSTAGRAM_OAUTH_STATE_SECRET=

# ---- Google ----
GOOGLE_PLACES_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/business/gbp/callback

# ---- DataForSEO ----
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ---- Token Encryption (GBP OAuth tokens) ----
TOKEN_ENCRYPTION_KEY_1=replace-with-random-32-char-secret
CURRENT_ENCRYPTION_VERSION=1

# ---- Admin login (seeded at boot) ----
ADMIN_SEED_EMAIL=admin@postengine.local
ADMIN_SEED_PASSWORD=ChangeMe!123
ADMIN_SEED_NAME=PostEngine Admin
ADMIN_SEED_RESET_PASSWORD=false

# ---- Frontend origins ----
ADMIN_PANEL_ORIGIN=http://localhost:5173
MOBILE_APP_SCHEME=postengine

# ── Email branding / deliverability ───────────────────────────────────────────
# Blank values are omitted from the email rather than rendered as dead links,
# which are themselves a spam signal.
MAIL_REPLY_TO=
MAIL_SITE_URL=
MAIL_PRIVACY_URL=
MAIL_TERMS_URL=
MAIL_SUPPORT_EMAIL=
MAIL_UNSUBSCRIBE_URL=

# ── Google Business Profile performance cache ────────────────────────────────
# The Performance API is capped per project per day and these are daily-
# granularity metrics, so reads are served from our cache by default.
# TTL before a refresh is attempted.
GBP_INSIGHTS_TTL_HOURS=24
# Hard floor between refreshes, even when ?refresh=1 is passed.
GBP_INSIGHTS_MIN_REFRESH_MINUTES=360
# Size of the reporting window, and of the comparison window before it.
GBP_INSIGHTS_WINDOW_DAYS=30

# ── Google Business Profile reviews cache ────────────────────────────────────
# Reviews come from the legacy My Business v4 API, which is allowlisted per
# Google Cloud project and quota-limited. Shorter TTL than insights because
# reviews arrive through the day rather than once daily.
GBP_REVIEWS_TTL_HOURS=6
GBP_REVIEWS_MIN_REFRESH_MINUTES=30

# Google rate-limits a location fetch issued right after the OAuth grant, so
# the first sync waits instead of burning an attempt. The client shows a
# countdown for this period.
GBP_INITIAL_SYNC_DELAY_MS=120000
# A manual retry happens minutes later and does not need the full wait.
GBP_RETRY_SYNC_DELAY_MS=5000
